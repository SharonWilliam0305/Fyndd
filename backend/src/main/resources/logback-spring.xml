<configuration>
 <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
 <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender"><encoder><pattern>%d{ISO8601} level=%level logger=%logger{25} thread=%thread %kvp message=%msg%n</pattern></encoder></appender>
 <root level="INFO"><appender-ref ref="CONSOLE"/></root>
</configuration>
